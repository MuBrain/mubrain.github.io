---
/**
 * PageLayout is intentionally only a semantic alias of LandingLayout.
 * This guarantees the exact same Navbar and LandingFooter as the home page.
 */
import LandingLayout from './LandingLayout.astro';
import type { Locale } from '@/i18n/config';
import type { RouteId } from '@/i18n/routes';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  includeOrgSchema?: boolean;
  lang?: Locale;
  routeId?: RouteId;
}

const props = Astro.props;
---

<LandingLayout {...props}>
  <slot />
</LandingLayout>
