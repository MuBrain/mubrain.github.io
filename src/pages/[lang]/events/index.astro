---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';
import { locales, defaultLocale, isValidLocale, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return locales
    .filter((lang) => lang !== defaultLocale)
    .map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
if (!lang || !isValidLocale(lang)) {
  return Astro.redirect('/events');
}

const locale = lang as Locale;

const title = 'MuBrain Events';
const description =
  'MuBrain meetups on collective intelligence, the Enterprise Brain, organizational memory, and collaboration between humans and AI agents.';

const events = (await getCollection('events'))
  .filter((event) => !event.data.draft && event.data.locale === locale)
  .sort((a, b) => a.data.startsAt.getTime() - b.data.startsAt.getTime());

const upcoming = events.filter((event) => event.data.endsAt >= new Date());
const past = events.filter((event) => event.data.endsAt < new Date()).reverse();

const formatter = new Intl.DateTimeFormat('en-CA', {
  dateStyle: 'long',
  timeStyle: 'short',
  timeZone: 'America/Toronto',
});

const getEventUrl = (eventId: string) => {
  const slug = eventId.replace(`${locale}/`, '');
  return `/${locale}/events/${slug}/`;
};
---

<PageLayout title={title} description={description} lang={locale} routeId="events">
  <section class="border-b border-border bg-secondary py-20">
    <div class="container">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">MuBrain Meetups</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        Thinking together about organizational intelligence.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-foreground-muted">
        MuBrain organizes regular in-person meetups to challenge ideas, practices, and research
        around collective intelligence, organizational memory, the Enterprise Brain, and
        collaboration between humans and AI agents.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <h2 class="text-3xl font-bold tracking-tight text-foreground">Upcoming meetups</h2>

      {upcoming.length === 0 ? (
        <div class="mt-8 rounded-2xl border border-border bg-background-subtle p-8">
          <p class="text-lg text-foreground-muted">
            Upcoming meetups are being prepared. Dates and topics will be announced here soon.
          </p>
        </div>
      ) : (
        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          {upcoming.map((event) => (
            <article class="rounded-2xl border border-border bg-background-subtle p-8">
              <div class="flex flex-wrap items-center gap-3">
                <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">
                  {formatter.format(event.data.startsAt)}
                </p>
                {event.data.dateStatus === 'tentative' && (
                  <span class="rounded-full border border-border px-2.5 py-1 text-xs font-semibold text-foreground-muted">
                    Date to be confirmed
                  </span>
                )}
              </div>
              <h3 class="mt-3 text-2xl font-semibold text-foreground">
                <a href={getEventUrl(event.id)} class="hover:text-brand-600">
                  {event.data.title}
                </a>
              </h3>
              <p class="mt-4 text-foreground-muted">{event.data.description}</p>
              <p class="mt-5 text-sm text-foreground-muted">
                {[event.data.venue, event.data.city].filter(Boolean).join(' · ')}
                {event.data.online ? ' · Online participation' : ''}
              </p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  {past.length > 0 && (
    <section class="border-t border-border py-16">
      <div class="container">
        <h2 class="text-3xl font-bold tracking-tight text-foreground">Past meetups</h2>
        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          {past.map((event) => (
            <article class="rounded-2xl border border-border p-6">
              <p class="text-sm text-foreground-muted">{formatter.format(event.data.startsAt)}</p>
              <h3 class="mt-2 text-xl font-semibold text-foreground">
                <a href={getEventUrl(event.id)} class="hover:text-brand-600">
                  {event.data.title}
                </a>
              </h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</PageLayout>
