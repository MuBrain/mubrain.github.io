---
import { getCollection } from 'astro:content';
import PageLayout from '@/layouts/PageLayout.astro';

const title = 'Évènements MuBrain';
const description =
  'Les rencontres MuBrain consacrées à l’intelligence collective, à l’Enterprise Brain et aux relations entre intelligences humaines et artificielles.';

const events = (await getCollection('events'))
  .filter((event) => !event.data.draft && event.data.locale === 'fr')
  .sort((a, b) => a.data.startsAt.getTime() - b.data.startsAt.getTime());

const upcoming = events.filter((event) => event.data.endsAt >= new Date());
const past = events.filter((event) => event.data.endsAt < new Date()).reverse();

const formatter = new Intl.DateTimeFormat('fr-CA', {
  dateStyle: 'long',
  timeStyle: 'short',
  timeZone: 'America/Toronto',
});
---

<PageLayout title={title} description={description} routeId="events">
  <section class="border-b border-border bg-secondary py-20">
    <div class="container">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">Rencontres MuBrain</p>
      <h1 class="mt-4 max-w-4xl text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
        Penser ensemble l’intelligence des organisations.
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-foreground-muted">
        MuBrain organise des rencontres régulières pour confronter les idées, les pratiques et les
        travaux de recherche autour de l’intelligence collective, de la mémoire organisationnelle,
        de l’Enterprise Brain et de la collaboration entre humains et agents IA.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container">
      <h2 class="text-3xl font-bold tracking-tight text-foreground">Prochaines rencontres</h2>

      {upcoming.length === 0 ? (
        <div class="mt-8 rounded-2xl border border-border bg-background-subtle p-8">
          <p class="text-lg text-foreground-muted">
            Les prochaines rencontres sont en préparation. Les dates et sujets seront annoncés ici prochainement.
          </p>
        </div>
      ) : (
        <div class="mt-8 grid gap-6 lg:grid-cols-2">
          {upcoming.map((event) => (
            <article class="rounded-2xl border border-border bg-background-subtle p-8">
              <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">
                {formatter.format(event.data.startsAt)}
              </p>
              <h3 class="mt-3 text-2xl font-semibold text-foreground">
                <a href={'/events/' + event.id + '/'} class="hover:text-brand-600">
                  {event.data.title}
                </a>
              </h3>
              <p class="mt-4 text-foreground-muted">{event.data.description}</p>
              <p class="mt-5 text-sm text-foreground-muted">
                {[event.data.venue, event.data.city].filter(Boolean).join(' · ')}
                {event.data.online ? ' · Participation en ligne' : ''}
              </p>
            </article>
          ))}
        </div>
      )}
    </div>
  </section>

  {past.length > 0 && (
    <section class="border-t border-border py-16">
      <div class="container">
        <h2 class="text-3xl font-bold tracking-tight text-foreground">Rencontres précédentes</h2>
        <div class="mt-8 grid gap-6 lg:grid-cols-3">
          {past.map((event) => (
            <article class="rounded-2xl border border-border p-6">
              <p class="text-sm text-foreground-muted">{formatter.format(event.data.startsAt)}</p>
              <h3 class="mt-2 text-xl font-semibold text-foreground">
                <a href={'/events/' + event.id + '/'} class="hover:text-brand-600">
                  {event.data.title}
                </a>
              </h3>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}
</PageLayout>
